% parameters at T_h (Table 3), units MPa and s
% Pour le moment les valeurs correspondent a T low
p.E   = 907;
p.mu  = 116000;      % 2.03 GPa·s -> MPa·s
p.lam = 2840;
p.C = 0.716
p.el = 0.000184

dt   = 0.1;              % s
tend = 1000;             % s
N    = round(tend/dt);

preallocate history arrays
t   = (0:N)'*dt;
sig = zeros(N+1,1);
eps = zeros(N+1,1);

% initial state: 
sig(1)=0.5
eps(1)=0.0181
eps_c =0

for n = 1:N
    eps_s = max(0, p.C*(eps_c - p.el))
    [sd, ed] = slv(sig(n), eps(n), 0, 'strain', p);   % creep: sig held constant
    sig(n+1) = sig(n) + dt*sd
    eps(n+1) = eps(n) + dt*ed
    eps_c = max(eps_c, strain(n+1))
end

% analytical solution for comparison, then plot both